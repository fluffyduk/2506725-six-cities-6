{
    "name": "six-cities",
    "version": "4.0.0",
    "description": "Проект «Шесть городов» от HTML Academy",
    "keywords": [
        "rest",
        "api",
        "node.js"
    ],
    "main": "main.js",
    "scripts": {
        "start": "npm run build && node ./dist/main.rest.js",
        "start::dev": "nodemon",
        "build": "npm run clean && npm run compile",
        "lint": "eslint src/ --ext .ts",
        "compile": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "ts": "tsx",
        "cli": "node --import ts-node/esm ./src/main.cli.ts",
        "json-server": "json-server ./mocks/mock-server-data.json --port 3123"
    },
    "devDependencies": {
        "@types/convict": "^6.1.6",
        "@types/convict-format-with-validator": "^6.0.6",
        "@types/express": "^5.0.6",
        "@types/node": "^18.16.3",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "eslint": "^8.57.1",
        "eslint-config-htmlacademy": "9.1.1",
        "json-server": "^1.0.0-beta.12",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "rimraf": "3.0.2",
        "ts-node": "10.9.1",
        "typescript": "5.7"
    },
    "type": "module",
    "engines": {
        "node": "^18.0.0",
        "npm": ">=8"
    },
    "dependencies": {
        "@typegoose/typegoose": "^13.2.1",
        "@types/mime-types": "^3.0.1",
        "@types/multer": "^2.1.0",
        "axios": "^1.13.6",
        "chalk": "^5.6.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "convict": "^6.2.4",
        "convict-format-with-validator": "^6.2.0",
        "dayjs": "^1.11.19",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-async-handler": "^1.2.0",
        "http-status-codes": "^2.3.0",
        "inversify": "^7.11.0",
        "jose": "^6.2.3",
        "mime-types": "^3.0.2",
        "mongoose": "^9.2.4",
        "multer": "^2.1.1",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0"
    }
}
